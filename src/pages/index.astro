---
// The home page is the blog index.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/blog/PostList.astro';
import { useT } from '../i18n/t';
import { getPosts } from '../utils/posts';

const t = useT(Astro.currentLocale);

const posts = await getPosts();
---

<BaseLayout title="Notebook" description={t.blogDescription}>
  <div class="mx-auto max-w-[44.8rem] px-4 py-12 sm:py-16">
    <h1 class="text-[2.1rem] font-light tracking-tight">Notebook</h1>
    <div class="mt-8">
      <PostList posts={posts} />
    </div>
  </div>
</BaseLayout>
