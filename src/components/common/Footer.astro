---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../../config';
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);

const year = new Date().getFullYear();
const themeCredit = 'https://www.inkledge.com';
---

<footer class="border-border border-t">
  <div class="hang text-muted mx-auto max-w-page px-4 pt-10 pb-14 font-sans text-sm">
    <div>
      <p>
        © {year} {site.author} ·{' '}
        <a href={themeCredit} rel="nofollow" class="text-muted hover:text-foreground underline">
          InkLedge
        </a>{' '}
        theme by ondelva
      </p>
      <ul class="mt-3 -ml-2.5 flex gap-1">
        {nav.social.map(({ label, href, icon }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              rel="me noopener"
              class="text-muted hover:text-foreground inline-flex size-10 items-center justify-center"
            >
              <Icon name={icon} class="size-5" aria-hidden="true" />
            </a>
          </li>
        ))}
        <li>
          <a
            href="/rss.xml"
            aria-label={t.rss}
            class="text-muted hover:text-foreground inline-flex size-10 items-center justify-center"
          >
            <Icon name="lucide:rss" class="size-5" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
